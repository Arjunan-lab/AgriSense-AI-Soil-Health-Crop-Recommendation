# =================================================================
# Crop Recommendation System — Frontend Environment Configuration
# =================================================================

# Centralized API Base URL for Backend Server
# Change only this URL to connect the frontend to a different backend server
VITE_API_BASE_URL=http://localhost:8000

# WebSocket Base URL for real-time notifications/chat
VITE_SOCKET_URL=ws://localhost:8000/ws

# File Upload / Assets URL
VITE_UPLOAD_URL=http://localhost:8000/uploads

# External Third-Party APIs (Configurable / Proxyable)
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1
VITE_GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1
VITE_NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# Optional Third-Party Keys
VITE_GOOGLE_MAP_KEY=
